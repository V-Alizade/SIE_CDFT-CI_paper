@SET RESTART_1            TRUE
@SET WFN_FILE_1           ./CDFT/04-bh76-ch3oh-f-rct-b3lyp-cdft-state1-1_0.wfn

@SET RESTART_2            TRUE
@SET WFN_FILE_2           ./CDFT/04-bh76-ch3oh-f-rct-b3lyp-cdft-state2-1_0.wfn

@SET DFT_FILE_1           dft-b3lyp-state1-common-params.inc
@SET DFT_FILE_2           dft-b3lyp-state2-common-params.inc

@SET PROJECT_NAME         04-bh76-ch3oh-f-rct-b3lyp-cdftci
@SET XYZFILE              ./XYZ/04-bh76-ch3oh-f-rct-cp2k.xyz

@SET PW_CUTOFF            300
@SET PW_REL_CUTOFF        50

@SET SYS_CHARGE           -1
@SET SYS_MULTIPLICITY     1
@SET SAVE_CUBE            FALSE
@SET CENTER_SYS           OFF

@SET BECKE_ACTIVE         TRUE

@SET BECKE_STR_1          0.393333715333
@SET BECKE_STR_2          0.281651377737
@SET BECKE_TARGET_1       13.942348224935
@SET BECKE_TARGET_2       14.496105901318

@SET BECKE_FRAG_CONSTRAINT FALSE
@SET BECKE_FRAG_A         dummy.cube
@SET BECKE_FRAG_A_SPIN    dummy.cube
@SET BECKE_FRAG_B         dummy.cube
@SET BECKE_FRAG_B_SPIN    dummy.cube

&GLOBAL
  PROJECT ${PROJECT_NAME}
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&MULTIPLE_FORCE_EVALS
  FORCE_EVAL_ORDER 2 3
  MULTIPLE_SUBSYS F
&END
&FORCE_EVAL
  METHOD MIXED
  &MIXED
    MIXING_TYPE MIXED_CDFT
    NGROUPS 1
    &MIXED_CDFT
      COUPLING 1
      LAMBDA 1.0
      CI .TRUE.
      &PRINT
        &PROGRAM_RUN_INFO ON
        &END
      &END PRINT
    &END MIXED_CDFT
  &END MIXED
  @include subsys.inc
&END FORCE_EVAL
&FORCE_EVAL
  @SET WFN_FILE       ${WFN_FILE_1}
  @SET RESTART        ${RESTART_1}
  @SET NAME           ${PROJECT_NAME}-state1
  @SET BECKE_TARGET   ${BECKE_TARGET_1}
  @SET BECKE_STR      ${BECKE_STR_1}
  METHOD QS
  @include ${DFT_FILE_1}
&END FORCE_EVAL
&FORCE_EVAL
  @SET WFN_FILE       ${WFN_FILE_2}
  @SET RESTART        ${RESTART_2}
  @SET NAME           ${PROJECT_NAME}-state2
  @SET BECKE_TARGET   ${BECKE_TARGET_2}
  @SET BECKE_STR      ${BECKE_STR_2}
  METHOD QS
  @include ${DFT_FILE_2}
&END FORCE_EVAL
