&GLOBAL
  PROJECT bh76-ch3oh-rct-pbe
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    CHARGE 0
    MULTIPLICITY 1
    LSD
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
      EXTRAPOLATION ASPC
      EXTRAPOLATION_ORDER 4
    &END QS
    &MGRID
      CUTOFF 300
      NGRIDS 5
      REL_CUTOFF 50
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER WAVELET
    &END POISSON
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      CHOLESKY INVERSE_DBCSR
      MAX_SCF 50
      &OT ON
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
        ALGORITHM IRAC
      &END OT
      &OUTER_SCF ON
        EPS_SCF 1.0E-6
        MAX_SCF 5
      &END OUTER_SCF
      &PRINT
        &RESTART ON
          FILENAME ./bh76-ch3oh-rct-pbe
          BACKUP_COPIES 2
          COMMON_ITERATION_LEVELS 1
          &EACH
            QS_SCF 0
          &END EACH
        &END RESTART
        &RESTART_HISTORY OFF
        &END RESTART_HISTORY
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &MULLIKEN ON
      &END MULLIKEN
      &LOWDIN ON
      &END LOWDIN
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      PERIODIC NONE
      ABC 40.0 40.0 40.0
    &END CELL
    &TOPOLOGY
      COORD_FILE_FORMAT XYZ
      COORD_FILE_NAME bh76-ch3oh-rct.xyz
      &CENTER_COORDINATES TRUE
      &END CENTER_COORDINATES
    &END TOPOLOGY
    &KIND C
      BASIS_SET DZVP-MOLOPT-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES OFF
    &END FORCES
    &GRID_INFORMATION
    &END GRID_INFORMATION
  &END PRINT
&END FORCE_EVAL
