@SET RESTART_1            FALSE
@SET WFN_FILE_1           ./KS/he2-plus-dist-1.50-b3lyp-energy-q1-1_0.wfn

@SET DFT_FILE             dft-b3lyp-common-params.inc

@SET PROJECT_NAME         he2-plus-dist-1.50-b3lyp-cdft-state1
@SET XYZFILE              ./XYZ/he2-plus-dist-1.50.xyz

@SET PW_CUTOFF            300
@SET PW_REL_CUTOFF        50
@SET SYS_CHARGE           1
@SET SYS_MULTIPLICITY     2
@SET SAVE_CUBE            FALSE
@SET CENTER_SYS           ON

@SET BECKE_ACTIVE         TRUE
@SET BECKE_STR_1          0.0
@SET BECKE_TARGET_1       0.0

@SET BECKE_FRAG_CONSTRAINT TRUE
@SET BECKE_FRAG_A         ./Cube/he2-plus-dist-1.50-frag-1-b3lyp-energy-q1-ELECTRON_DENSITY-1_0.cube
@SET BECKE_FRAG_A_SPIN    ./Cube/he2-plus-dist-1.50-frag-1-b3lyp-energy-q1-SPIN_DENSITY-1_0.cube
@SET BECKE_FRAG_B         ./Cube/he2-plus-dist-1.50-frag-2-b3lyp-energy-q0-ELECTRON_DENSITY-1_0.cube
@SET BECKE_FRAG_B_SPIN    ./Cube/he2-plus-dist-1.50-frag-2-b3lyp-energy-q0-SPIN_DENSITY-1_0.cube
@SET BECKE_ATOM           1
@SET BECKE_DUMMY_ATOM     2

&GLOBAL
  PROJECT ${PROJECT_NAME}
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  @SET WFN_FILE     ${WFN_FILE_1}
  @SET RESTART      ${RESTART_1}
  @SET NAME         ${PROJECT_NAME}
  @SET BECKE_TARGET ${BECKE_TARGET_1}
  @SET BECKE_STR    ${BECKE_STR_1}
  METHOD QS
  @include ${DFT_FILE}
  @include subsys.inc
&END FORCE_EVAL
