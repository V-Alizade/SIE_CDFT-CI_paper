@SET RESTART_1            TRUE
@SET WFN_FILE_1           ./Frag/he2-plus-dist-4.00-frag-1-b3lyp-energy-q0-1_0.wfn

@SET DFT_FILE             dft-b3lyp-common-params.inc

@SET PROJECT_NAME         he2-plus-dist-4.50-frag-1-b3lyp-energy-q0
@SET XYZFILE              ./XYZ/he2-plus-dist-4.50-frag-1.xyz

@SET PW_CUTOFF            300
@SET PW_REL_CUTOFF        50
@SET SYS_CHARGE           0
@SET SYS_MULTIPLICITY     1
@SET SAVE_CUBE            TRUE
@SET CENTER_SYS           OFF

@SET BECKE_ACTIVE         FALSE
@SET BECKE_STR_1          0.0
@SET BECKE_TARGET_1       0.0

@SET BECKE_FRAG_CONSTRAINT FALSE
@SET BECKE_FRAG_A         dummy.cube
@SET BECKE_FRAG_A_SPIN    dummy.cube
@SET BECKE_FRAG_B         dummy.cube
@SET BECKE_FRAG_B_SPIN    dummy.cube
@SET BECKE_ATOM           1
@SET BECKE_DUMMY_ATOM     2

&GLOBAL
  PROJECT ${PROJECT_NAME}
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  @SET WFN_FILE     ${WFN_FILE_1}
  @SET RESTART      ${RESTART_1}
  @SET NAME         ${PROJECT_NAME}
  @SET BECKE_TARGET ${BECKE_TARGET_1}
  @SET BECKE_STR    ${BECKE_STR_1}
  METHOD QS
  @include ${DFT_FILE}
  @include subsys.inc
&END FORCE_EVAL
